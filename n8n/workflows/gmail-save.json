        "jsCode": "const text = ($json.body || '').replace(/[\\n\\r\\t]/g, ' ').slice(0, 10000);\n\nreturn {\n  json: {\n    gmail_id: $json.gmail_id,\n    gmail_text: $json.body,\n    geminiBody: {\n      contents: [{\n        parts: [{\n          text: `create a brief bullet point summary for this email body:\\n\\n${$json.body}.  Only include the bullet points. Use dashes for bullet points and preceed dash with '\\n' so each bullet is on a new line.`\n        }]\n      }]\n    }\n  }\n};\n"
      },
