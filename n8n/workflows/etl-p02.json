    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DO $$\nDECLARE r RECORD;\nBEGIN\n  CALL etl.p02_l09(); -- referential constraints\n\n  -- Reset sequences to max(id) after ETL load\n  FOR r IN\n    SELECT table_name\n    FROM information_schema.columns\n    WHERE table_schema = 'whatsfresh'\n      AND column_name = 'id'\n      AND column_default LIKE 'nextval%'\n  LOOP\n    EXECUTE format(\n      'SELECT setval(pg_get_serial_sequence(%L, ''id''), COALESCE((SELECT MAX(id) FROM whatsfresh.%I), 1))',\n      'whatsfresh.' || r.table_name, r.table_name\n    );\n  END LOOP;\nEND;\n$$;"
      },
