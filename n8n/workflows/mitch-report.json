    {
      "parameters": {
        "jsCode": "const html_raw = $json.styled_html || '';\nconst data = Array.isArray($json.data) ? $json.data : [];\nconst groupByField = $json.group_by;\n\nlet html = html_raw;\nconst eachRegex = /\\{\\{#each data\\}\\}([\\s\\S]*?)\\{\\{\\/each\\}\\}/;\nconst match = html.match(eachRegex);\n\nif (match) {\n  const rowTemplate = match[1];\n  const rows = data.map((item, index) => {\n    let row = '';\n    if (groupByField && (index === 0 || item[groupByField] !== data[index-1][groupByField])) {\n      row += `<tr class=\"group-hdr\"><td colspan=\"99\"><strong>${item[groupByField]}</strong></td></tr>`;\n    }\n    row += rowTemplate;\n    for (const [key, value] of Object.entries(item)) {\n      row = row.replace(new RegExp(`\\\\{\\\\{${key}\\\\}\\\\}`, 'g'), value ?? '');\n    }\n    return row;\n  }).join('');\n  html = html.replace(eachRegex, rows);\n}\n\nreturn [{ json: { html } }];\n"
      },
