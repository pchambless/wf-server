      "parameters": {
        "jsCode": "const { email, params, clear_all } = $input.first().json.body;\n\nlet sql;\nif (clear_all) {\n  sql = `\n    UPDATE whatsfresh.context_store \n    SET param_val = NULL, updates = updates + 1, updated_at = now()\n    WHERE email = '${email}'\n  `;\n} else {\n  const list = params.map(p => `'${p}'`).join(', ');\n  sql = `\n    UPDATE whatsfresh.context_store \n    SET param_val = NULL, updates = updates + 1, updated_at = now()\n    WHERE email = '${email}' AND param_name = ANY(ARRAY[${list}])\n  `;\n}\nreturn [{ json: { sql } }];"
