    {
      "parameters": {
        "jsCode": "const { email, vals } = $input.first().json.body;\nconst rows = vals.map(v => \n  `('${email}', '${v.param_name}', '${v.param_val}', 1, now(), '${email}')`\n).join(',\\n');\n\nconst sql = `\n  INSERT INTO whatsfresh.context_store (email, param_name, param_val, updates, created_at, created_by)\n  VALUES ${rows}\n  ON CONFLICT (email, param_name)\n  DO UPDATE SET \n    param_val = EXCLUDED.param_val,\n    updates = context_store.updates + 1,\n    updated_at = now(),\n    updated_by = EXCLUDED.created_by\n`;\nreturn [{ json: { sql } }];"
      },
