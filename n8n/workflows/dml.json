    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nconst { page_id, mode, user } = body;\n\n// Collect f_ prefixed fields and strip prefix\nconst p_data = {};\nlet pk_val = null;\n\nfor (const [key, value] of Object.entries(body)) {\n  if (key === 'f_id' || key === 'id') {\n    pk_val = value ? parseInt(value, 10) : null;\n    continue;\n  }\n  if (key.startsWith('f_')) {\n    const colName = key.slice(2);\n    p_data[colName] = value === '' ? null : value;\n  }\n}\n\n// For DELETE mode, pk_val may come from body.pk_val\nif (mode === 'DELETE' && !pk_val && body.pk_val) {\n  pk_val = parseInt(body.pk_val, 10);\n}\n\n// Build the SQL query - set session email first so c_getval() works\nconst dataJson = JSON.stringify(p_data).replace(/'/g, \"''\");\nconst pkExpr = pk_val === null ? 'NULL::integer' : pk_val;\nconst safeUser = (user || 'system').replace(/'/g, \"''\");\nconst sql = `WITH _ctx AS (SELECT set_config('app.current_email', '${safeUser}', false)) SELECT studio.dml(${parseInt(page_id, 10)}, '${mode || 'INSERT'}', '${dataJson}'::jsonb, ${pkExpr}, '${safeUser}') as result FROM _ctx`;\n\nreturn { json: { sql } };"
      },
      "id": "25945e6c-a4dd-4f71-a661-444184bc4d0b",
