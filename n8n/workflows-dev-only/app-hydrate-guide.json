        "jsCode": "const body = $('Webhook').item.json.body || {};\nlet sql = $json.hydrate;\nconst tn = $json.template_name;\nif (!sql || !sql.trim()) { return { json: { template_name: tn, hydrate_bound: null } }; }\nconst esc = (v) => v === null || v === undefined ? 'NULL' : (typeof v === 'number' ? String(v) : \"'\" + String(v).replace(/'/g, \"''\") + \"'\");\nsql = sql.replace(/(?<!:):([a-zA-Z_][a-zA-Z0-9_]*)/g, (m, name) => (name in body ? esc(body[name]) : 'NULL'));\nreturn { json: { template_name: tn, hydrate_bound: sql } };",
