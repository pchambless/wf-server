        "jsCode": "// L01-Validate: body = { to, subject, text and/or html, reply_to? }\nconst b = $input.first().json.body || {};\nconst EMAIL = /^[^\\s@,;<>\"]+@[^\\s@,;<>\"]+\\.[^\\s@,;<>\"]+$/;\nconst clean = (v) => (typeof v === 'string' ? v.trim() : '');\nconst to = clean(b.to);\nconst subject = clean(b.subject);\nconst text = typeof b.text === 'string' ? b.text : '';\nconst html = typeof b.html === 'string' ? b.html : '';\nconst replyTo = clean(b.reply_to);\nlet error = null;\nif (!EMAIL.test(to)) error = 'to must be a single valid email address';\nelse if (!subject || /[\\r\\n]/.test(subject)) error = 'subject is required and must be one line';\nelse if (!text && !html) error = 'text or html is required';\nelse if (replyTo && !EMAIL.test(replyTo)) error = 'reply_to must be a single valid email address';\nreturn [{ json: { valid: error === null, error, to, subject, text, html, replyTo } }];"
      },
